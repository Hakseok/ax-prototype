  "filters": [
    { "field": "requestedAt", "label": "요청 기간", "control": "dateRange", "default": "last30days", "required": true },
    { "field": "type", "label": "유형", "control": "select", "options": ["예지", "예방", "사후"] },
    { "field": "lineId", "label": "라인", "control": "select", "options": "lines" },
    { "field": "title", "label": "검색", "control": "text", "placeholder": "오더 번호·설비·내용", "fields": ["id", "equipmentId", "title"] }
  ],
  "list": {
    "stageField": "stage",
    "stages": ["요청", "승인", "작업 중", "완료", "효과 확인"],
