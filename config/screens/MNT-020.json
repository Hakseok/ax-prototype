    "columns": [
      { "field": "id", "label": "오더", "width": 150, "pinned": true },
      { "field": "stage", "label": "단계", "width": 90 },
      { "field": "type", "label": "유형", "width": 70 },
      { "field": "title", "label": "내용", "flex": 3 },
      { "field": "siteId", "label": "사업장", "ref": "sites", "width": 90, "showWhen": "company" },
      { "field": "lineId", "label": "라인", "ref": "lines", "flex": 1 },
      { "field": "requestedAt", "label": "요청", "format": "datetime", "width": 140 }
    ]
  },
  "content": { "title": "정비 오더" },
  "actions": ["조회", "신규", "저장", "승인", "반려", "완료", "확인", "내보내기"]
